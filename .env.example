# Reference values only. These are environment variables, not an auto-loaded file.
VMO_TEMPLATES_ROOT=D:\VMware\Template
VMO_VMS_ROOT=D:\VMware\Customers
VMO_DB_PATH=D:\VMware\VM-Orchestrator\data\templates.sqlite3
VMO_VMRUN_PATH=C:\Program Files\VMware\VMware Workstation\vmrun.exe
VMO_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Guest Gateway URL and CA are prepared by Launch-VMConsole.cmd before Host Agent.
# VMO_GUEST_GATEWAY_URL=https://192.0.2.10:8766
# VMO_GUEST_CA_PEM=D:\VMware\VM-Orchestrator\data\guest-gateway-tls\ca.pem

# V1.3: separate business connector secret (auto-created with Windows DPAPI by Start-WebConsole.ps1)
# VMO_BUSINESS_KEY=GENERATED_SEPARATELY_FROM_ADMIN_KEY
# Only set to 1 behind a trusted TLS-terminating customer-portal relay.
# VMO_CLIENT_SECURE_COOKIE=1

# V1.4.7: customer-browser HTTPS gateway address (public front to host port 8766).
# Only enable after a valid, browser-trusted HTTPS certificate and isolated app proxy are configured.
# VMO_PUBLIC_APP_GATEWAY_URL=https://apps.example.com
# HTTPS origin of client portal used for frame-ancestors. Full browser compatibility
# also depends on third-party Cookie policy; offer a new-tab fallback.
# VMO_PUBLIC_CLIENT_ORIGIN=https://clients.example.com

# V1.4.8: optional trusted HTTPS origin for embedding the customer portal
# VMO_PUBLIC_BUSINESS_ORIGIN=https://billing.example.com

# V1.4.11: Customer application windows use the SAME origin as /client.
# Host-side 8765 proxies only /apps/* to the private, CA-verified 8766.
# Keep VMO_GUEST_GATEWAY_URL/VMO_GUEST_CA_PEM configured by Start-WebConsole.ps1.
# Do not expose 8766 or its /agent/* routes directly to customer browsers.

# v1.4.15: administrator web listener. Defaults to all IPv4 NICs.
# NEVER expose 8765 directly to the Internet or untrusted Guest subnets.
# Set VMO_HOST_BIND=127.0.0.1 to opt back into loopback-only mode.
VMO_HOST_BIND=0.0.0.0

# Trusted external HTTPS origin for admin login behind DSM/ESA reverse proxy
VMO_PUBLIC_CONSOLE_ORIGIN=https://host.tmd.pet

# v1.4.27: admin browser credentials are created via Initialize-AdminAccount.cmd.
# Existing VMO_ADMIN_KEY remains as encryption root AND migrated revocable legacy API key.
# Never rotate the DPAPI encryption root when changing the web password.
# Set 1 only after the SibHosting connector sends expiry fields on all paid products.
VMO_REQUIRE_SERVICE_EXPIRY=0

# v1.4.28: expiry runs only inside the live 8765 Host process.
# No boot task, no VMO_EXPIRY_SERVICE_READY or VMO_EXPIRY_ACCEPTED flag.
